{
  "name": "@local/ws-connections",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "DSH 连接器：数据库、Redis、SSH、HTTP、TCP、消息机器人和其他 DSH 节点，配成一个全局连接池，模型用工具直接调用。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "test",
    "node_modules"
  ],
  "dependencies": {
    "mysql2": "^3.24.0",
    "pg": "^8.23.0",
    "ssh2": "^1.17.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
